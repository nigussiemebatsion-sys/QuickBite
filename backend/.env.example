# PostgreSQL connection
DB_USER=your_database_user
DB_HOST=your_database_host
DB_NAME=your_database_name
DB_PASSWORD=your_database_password
DB_PORT=5432

# Express server port
PORT=3000

# Set to "true" when connecting to a hosted PostgreSQL provider that requires SSL
DB_SSL=false

# Frontend origin for CORS (set this to your deployed frontend URL in production)
# Example: https://quickbite.netlify.app
FRONTEND_URL=http://localhost:5500
