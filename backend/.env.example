# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection — get these from Neon dashboard
# (Connection Details → Connection parameters)
DB_USER=your_database_user
DB_HOST=your_neon_host.neon.tech
DB_NAME=neondb
DB_PASSWORD=your_database_password
DB_PORT=5432

# SSL — MUST be "true" for Neon and all hosted PostgreSQL providers.
# Only set to "false" for a local PostgreSQL instance without SSL.
DB_SSL=true

# Express server port (Render sets this automatically)
PORT=3000

# Your deployed frontend URL — used for CORS in production.
# Example: https://quickbite.netlify.app
# For local development: http://localhost:5500
FRONTEND_URL=http://localhost:5500
